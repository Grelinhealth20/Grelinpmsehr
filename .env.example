# ─── Grelinpmsehr – Environment Variables ─────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is listed in .gitignore.
# ────────────────────────────────────────────────────────────────

# --- Backend API + WAF (TLS terminated by YOUR nginx) ---
# Your nginx serves the built SPA (:6001) and reverse-proxies /api (+ /healthz) to the backend (:6002).
COMBINED_EDGE=true                         # keeps WAF + hardened headers + rate-limits on /api
GATEWAY_ORIGIN=https://ehr.grelinhealth.com # canonical public origin (CORS allowlist)
GATEWAY_PORT=6002                          # plain HTTP the backend listens on; your nginx proxies /api here
GATEWAY_TLS=false                          # your nginx terminates TLS — the backend does NOT
TRUST_PROXY=true                           # honor X-Forwarded-* from your nginx (client IP for rate-limit/audit)
GATEWAY_CANONICAL_HOST=ehr.grelinhealth.com
FRONTEND_ORIGIN=http://127.0.0.1:6001      # unused (SPA served by your nginx); harmless fallback

# --- Database (MySQL) ---
DB_HOST=<YOUR_DB_HOST>
DB_PORT=3306
DB_USER=<db-username>
DB_PASSWORD=<db-password>
DB_NAME=grelin_pmsehr

# --- Cryptography (AES-256-GCM PHI encryption + HMAC blind index) ---
PHI_ENC_KEY=<base64-encoded-32-byte-key>
BLIND_INDEX_KEY=<base64-encoded-32-byte-key>

# --- JWT / Sessions ---
JWT_ACCESS_SECRET=<generate-a-random-64-char-key>
JWT_REFRESH_SECRET=<generate-a-random-64-char-key>

# --- AWS S3 ---
S3_BUCKET=pms-ehr
S3_REGION=us-east-2
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>

# --- OCR ---
OCR_API_KEY=

# --- Master Admin (created on first boot) ---
MASTER_ADMIN_EMAIL=<admin@example.com>
MASTER_ADMIN_PASSWORD=<strong-password>
MASTER_ADMIN_NAME=Master Administrator

# --- Stedi (eligibility 270/271) ---
STEDI_API_KEY=<your-stedi-api-key>
