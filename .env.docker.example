# Copy to .env  ->  `cp .env.docker.example .env`  then fill in real values.
# docker compose reads this automatically as the variable source.

# --- external database (your own MySQL — the stack does NOT run one) ---
# Use the reachable host/IP of your DB. If it runs on the Docker host machine,
# use  host.docker.internal  instead of 127.0.0.1.
DB_HOST=your-db-host-or-ip
DB_PORT=3306
DB_NAME=grelin_pmsehr
DB_USER=grelin
DB_PASSWORD=change-me-db-password
DB_SSL=false

# --- shared gateway<->backend secret (any long random string) ---
INTERNAL_API_KEY=change-me-internal-api-key

# --- PHI encryption (32-byte hex or base64 keys; generate with: openssl rand -hex 32) ---
PHI_ENC_KEY=change-me-32-byte-key
BLIND_INDEX_KEY=change-me-32-byte-key

# --- JWT signing secrets (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- first master admin (forced password reset on first login) ---
MASTER_ADMIN_EMAIL=admin@grelinhealth.com
MASTER_ADMIN_PASSWORD=ChangeMe-Str0ng-Passw0rd!
MASTER_ADMIN_NAME=Master Administrator
