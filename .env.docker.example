# ==============================================================================
# Grelin Health PMS & EHR — Docker Compose Environment Configuration
# ==============================================================================
# 1. Copy this file to .env:
#      cp .env.docker.example .env
# 2. Generate secure cryptography keys:
#      node backend/src/scripts/keygen.js
#    and paste the generated keys into PHI_ENC_KEY, BLIND_INDEX_KEY,
#    JWT_ACCESS_SECRET, and JWT_REFRESH_SECRET below.
# 3. Launch the stack:
#      docker compose up --build
# ==============================================================================

# --- Edge / Gateway Configuration ---
NODE_ENV=production
GATEWAY_PORT=8080
GATEWAY_ORIGIN=http://localhost:8080

# --- MySQL Database Configuration ---
# Used by both the 'db' container and 'backend' container
DB_ROOT_PASSWORD=grelin_root_secure_password_123!
DB_USER=grelin_user
DB_PASSWORD=grelin_app_secure_password_123!
DB_NAME=grelin_pmsehr
DB_PORT=3306

# If using an external MySQL host (e.g. AWS RDS or host machine), uncomment and set:
# DB_HOST=host.docker.internal

# --- Cryptography (AES-256-GCM PHI encryption & Blind Index) ---
# REQUIRED: 32-byte base64 encoded keys (Run `node backend/src/scripts/keygen.js` to generate)
PHI_ENC_KEY=
BLIND_INDEX_KEY=

# --- JWT / Session Secrets ---
# REQUIRED: Distinct secrets for access and refresh tokens
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=28800

# --- Master Administrator (seeded on first boot) ---
# Forced to change password on first login
MASTER_ADMIN_EMAIL=git@grelinhealth.com
MASTER_ADMIN_PASSWORD=Grelin@2026!!
MASTER_ADMIN_NAME=Master Administrator

# --- OCR Microservice Shared Secret ---
OCR_API_KEY=grelin_ocr_secret_key_change_me
OCR_TIMEOUT_MS=60000

# --- Optional Cloud & External Integrations ---
S3_BUCKET=
S3_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STEDI_API_KEY=
OPENAI_API_KEY=
UMLS_API_KEY=
