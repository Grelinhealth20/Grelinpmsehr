# ─── Grelin Health — BACKEND production env deltas (pms.grelinhealth.com) ─────
# These are the DOMAIN/TLS-related overrides for going live on the real domain.
# Keep every other value (DB, PHI_ENC_KEY, JWT secrets, S3, Stedi, master admin)
# from your existing backend/.env. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Turns on Secure cookies (gh_at / gh_rt / gh_csrf become HTTPS-only), HSTS, and
# the loopback-only internal-key gate. REQUIRED for production.
NODE_ENV=production

# The API binds loopback only; the gateway reaches it over 127.0.0.1.
API_HOST=127.0.0.1
API_PORT=4000

# CORS allowlist — MUST equal the gateway's GATEWAY_ORIGIN exactly (scheme+host,
# no trailing slash). The SPA is same-origin so this is a defense-in-depth guard.
GATEWAY_ORIGIN=https://pms.grelinhealth.com

# Must match the gateway's INTERNAL_API_KEY (proves requests came through the edge).
INTERNAL_API_KEY=<same-64-char-key-as-gateway-INTERNAL_API_KEY>

# Fax.Plus OAuth redirect — update to the real domain AND register this exact URI
# in the Fax.Plus app console, or the OAuth callback will be rejected.
FAXPLUS_REDIRECT_URI=https://pms.grelinhealth.com/api/fax/oauth/callback

# Database TLS (RDS / self-managed) — see AWS_DEPLOYMENT.md.
# DB_SSL=true
# DB_SSL_CA=./certs/db-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true
