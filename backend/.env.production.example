# ─── Grelin Health — BACKEND production env deltas (pms.grelinhealth.com) ─────
# These are the DOMAIN/TLS-related overrides for going live on the real domain.
# Keep every other value (DB, PHI_ENC_KEY, JWT secrets, S3, Stedi, master admin)
# from your existing backend/.env. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Turns on Secure cookies (gh_at / gh_rt / gh_csrf become HTTPS-only) and HSTS.
# REQUIRED for production.
NODE_ENV=production

# SINGLE PUBLIC EDGE: this backend IS the edge (WAF + TLS + /api + SPA proxy).
# There is no separate gateway and no internal-key handshake.
COMBINED_EDGE=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=6002            # HTTP  (301 → HTTPS, plus /healthz)
GATEWAY_HTTPS_PORT=6004      # HTTPS (the public service)
GATEWAY_TLS=true
GATEWAY_CANONICAL_HOST=pms.grelinhealth.com
TLS_CERT_PATH=/app/tls/pms_grelinhealth_fullchain.crt
TLS_KEY_PATH=/app/tls/pms_grelinhealth.key
FRONTEND_ORIGIN=http://grelin-ehr-pms-frontend:6001
# Set to the hop count (e.g. 1) ONLY if an AWS ALB/NLB terminates TLS in front; with
# direct TLS termination here leave it false so X-Forwarded-For cannot be spoofed.
TRUST_PROXY=false

# CORS allowlist — the canonical public origin (scheme+host, no trailing slash). The
# SPA is same-origin so this is a defense-in-depth guard for cross-origin callers.
GATEWAY_ORIGIN=https://pms.grelinhealth.com

# Fax.Plus OAuth redirect — update to the real domain AND register this exact URI
# in the Fax.Plus app console, or the OAuth callback will be rejected.
FAXPLUS_REDIRECT_URI=https://pms.grelinhealth.com/api/fax/oauth/callback

# Database TLS (RDS / self-managed) — see AWS_DEPLOYMENT.md.
# DB_SSL=true
# DB_SSL_CA=./certs/db-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true
