# ─── Grelin Health — BACKEND production env deltas (ehr.grelinhealth.com) ─────
# Domain/edge overrides for going live BEHIND YOUR nginx. Your nginx terminates TLS
# for https://ehr.grelinhealth.com, serves the built SPA on :6001, and reverse-proxies
# /api (+ /healthz) to this backend on :6002. Keep every other value (DB, PHI_ENC_KEY,
# JWT secrets, S3, Stedi, master admin) from your existing backend/.env. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Turns on Secure cookies (gh_at / gh_rt / gh_csrf become HTTPS-only) and HSTS.
# REQUIRED for production. (Cookies are Secure because the PUBLIC origin is HTTPS at your nginx.)
NODE_ENV=production

# API + WAF, with TLS terminated UPSTREAM by your nginx. COMBINED_EDGE stays true so the
# WAF + hardened headers + edge rate-limits keep running on every /api request; the backend
# just serves plain HTTP on :6002 behind your nginx (no TLS here, no separate gateway).
COMBINED_EDGE=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=6002            # plain HTTP — your nginx proxies /api (+ /healthz) here
GATEWAY_TLS=false            # your nginx terminates TLS; the backend does NOT
GATEWAY_CANONICAL_HOST=ehr.grelinhealth.com
# Your nginx is a trusted reverse proxy in front — honor X-Forwarded-* so client IP is
# correct for rate-limiting and audit. (Only set true when a trusted proxy is actually in front.)
TRUST_PROXY=true
# The SPA is served by your nginx, so the backend's SPA reverse-proxy is unused; route ONLY
# /api (+ /healthz) to the backend. This is a harmless fallback for any stray non-/api request.
FRONTEND_ORIGIN=http://127.0.0.1:6001

# CORS allowlist — the canonical public origin (scheme+host, no trailing slash).
GATEWAY_ORIGIN=https://ehr.grelinhealth.com

# Fax.Plus OAuth redirect — update to the real domain AND register this exact URI
# in the Fax.Plus app console, or the OAuth callback will be rejected.
FAXPLUS_REDIRECT_URI=https://ehr.grelinhealth.com/api/fax/oauth/callback

# Database TLS (RDS / self-managed) — see AWS_DEPLOYMENT.md.
# DB_SSL=true
# DB_SSL_CA=./certs/db-ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true
