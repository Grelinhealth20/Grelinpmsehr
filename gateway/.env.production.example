# ─── Grelin Health — GATEWAY production env (pms.grelinhealth.com) ────────────
# Topology: SINGLE EC2 — the gateway terminates TLS itself (no ALB in front).
# Copy to gateway/.env on the EC2 host and fill in the real secret values.
# NEVER commit the real .env — only this *.example template is tracked.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
GATEWAY_HOST=0.0.0.0

# Internal API (loopback / private). Must match the backend's API_HOST:API_PORT.
INTERNAL_API_URL=http://127.0.0.1:4000
INTERNAL_API_KEY=<same-64-char-key-as-backend-INTERNAL_API_KEY>

# The public origin the browser sees. Used for the HTTP→HTTPS redirect host and
# for the backend's CORS allowlist (must match backend GATEWAY_ORIGIN exactly).
GATEWAY_ORIGIN=https://pms.grelinhealth.com
GATEWAY_CANONICAL_HOST=pms.grelinhealth.com

# WAF stays in blocking mode in production.
WAF_BLOCKING=true
WAF_IP_ALLOWLIST=
WAF_IP_BLOCKLIST=

# Serve the built SPA off disk (single box). Build with: (cd frontend && npm run build)
FRONTEND_DIST=../frontend/dist

# ─── TLS — gateway terminates HTTPS on this EC2 box ──────────────────────────
GATEWAY_TLS=true
GATEWAY_HTTPS_PORT=443
GATEWAY_PORT=80            # plain HTTP listener → 301 redirect to HTTPS
TLS_CERT_PATH=./certs/pms_grelinhealth_fullchain.crt   # already staged (leaf+intermediates)
TLS_KEY_PATH=./certs/pms_grelinhealth.key              # <-- DROP THE PRIVATE KEY HERE (0600)
# No proxy in front on a single box, so do NOT trust X-Forwarded-* (spoofable).
TRUST_PROXY=false

# NOTE — binding 443/80 needs privilege on Linux. Either:
#   sudo setcap 'cap_net_bind_service=+ep' $(which node)   # preferred
#   (or run the gateway behind systemd as root, or via an nginx/iptables :443→:6004 redirect).
# EC2 security group must allow inbound 443 (and 80 for the redirect).

# Verify the private key matches the staged cert BEFORE starting (both md5s must be equal):
#   openssl x509 -in certs/pms_grelinhealth_fullchain.crt -noout -modulus | openssl md5   # d40f631f...
#   openssl rsa  -in certs/pms_grelinhealth.key          -noout -modulus | openssl md5   # must match

# ─── Alternative (NOT this deployment): a load balancer terminates TLS ───────
# GATEWAY_TLS=false ; GATEWAY_PORT=6002 ; TRUST_PROXY=1  (LB holds the cert)
