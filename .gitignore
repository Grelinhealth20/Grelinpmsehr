# Dependencies
node_modules/

# Environment / secrets — NEVER commit
.env
*.env
!/**/.env.example

# Deploy compose holds live prod secrets (PHI key, DB pw, AWS/Stedi keys) — keep out of git.
# The real file lives on the host; commit only sanitized templates/examples if needed.
docker-compose.yml

# Build output
frontend/dist/

# TLS certificates (never commit private keys)
certs/
*.crt
*.key
*.pem
# Exception: the pinned DB server CA is a PUBLIC certificate (not a private key) and
# must ship so the API can verify the MySQL TLS chain against it.
!backend/certs/db-ca.pem

# Logs
*.log
logs/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
